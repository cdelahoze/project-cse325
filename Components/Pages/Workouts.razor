@page "/workouts"
@using BlazorApp.Models
@using BlazorApp.Services
@inject WorkoutService WorkoutService

<h3>Log Workout</h3>

<EditForm Model="newWorkout" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <div>
        <label>Exercise Type</label>
        <InputText @bind-Value="newWorkout.ExerciseType" />
    </div>
    <div>
        <label>Duration (min)</label>
        <InputNumber @bind-Value="newWorkout.DurationMinutes" />
    </div>
    <div>
        <label>Date</label>
        <InputDate @bind-Value="newWorkout.Date" />
    </div>
    <div>
        <label>Notes</label>
        <InputTextArea @bind-Value="newWorkout.Notes" />
    </div>
    <button type="submit">Add</button>
</EditForm>

<h4>Workouts</h4>
@if (workouts is null)
{
    <p>Loading...</p>
}
else if (!workouts.Any())
{
    <p>No workouts recorded.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Type</th>
                <th>Duration</th>
                <th>Date</th>
                <th>Notes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in workouts)
            {
                <tr>
                    <td>@w.ExerciseType</td>
                    <td>@w.DurationMinutes</td>
                    <td>@w.Date.ToString("g")</td>
                    <td>@w.Notes</td>
                    <td>
                        <button @onclick="() => StartEdit(w.Id)">Edit</button>
                        <button @onclick="() => Delete(w.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (isEditing && editWorkout is not null)
{
    <h4>Edit Workout</h4>
    <EditForm Model="editWorkout" OnValidSubmit="HandleEditSubmit">
        <DataAnnotationsValidator />
        <div>
            <label>Exercise Type</label>
            <InputText @bind-Value="editWorkout.ExerciseType" />
        </div>
        <div>
            <label>Duration (min)</label>
            <InputNumber @bind-Value="editWorkout.DurationMinutes" />
        </div>
        <div>
            <label>Date</label>
            <InputDate @bind-Value="editWorkout.Date" />
        </div>
        <div>
            <label>Notes</label>
            <InputTextArea @bind-Value="editWorkout.Notes" />
        </div>
        <button type="submit">Save</button>
        <button type="button" @onclick="CancelEdit">Cancel</button>
    </EditForm>
}

@code {
    private List<Workout>? workouts;
    private Workout newWorkout = new();
    private bool isEditing = false;
    private Workout? editWorkout;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        workouts = await WorkoutService.GetAllAsync();
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        await WorkoutService.AddAsync(newWorkout);
        newWorkout = new Workout();
        await Load();
    }

    private void StartEdit(Guid id)
    {
        var w = workouts?.FirstOrDefault(x => x.Id == id);
        if (w != null)
        {
            editWorkout = new Workout
            {
                Id = w.Id,
                ExerciseType = w.ExerciseType,
                DurationMinutes = w.DurationMinutes,
                Date = w.Date,
                Notes = w.Notes
            };
            isEditing = true;
        }
    }

    private async Task HandleEditSubmit()
    {
        if (editWorkout is null) return;
        await WorkoutService.UpdateAsync(editWorkout);
        isEditing = false;
        editWorkout = null;
        await Load();
    }

    private void CancelEdit()
    {
        isEditing = false;
        editWorkout = null;
    }

    private async Task Delete(Guid id)
    {
        await WorkoutService.DeleteAsync(id);
        await Load();
    }
}
