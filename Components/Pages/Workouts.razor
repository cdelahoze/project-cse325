@page "/workouts"
@using BlazorApp.Models
@using BlazorApp.Services
@inject WorkoutService WorkoutService

<PageTitle>Workouts</PageTitle>

<section class="page-header">
    <p class="dashboard-label">Fitness</p>
    <h1>Workout Tracking</h1>
    <p>
        Log workouts, review recorded exercises, edit entries, and remove workouts when needed.
        This page supports the fitness tracking part of the project.
    </p>
</section>

<div class="form-layout">
    <div class="feature-card form-card">
        <h3>Log Workout</h3>
        <p class="form-helper">
            Add a workout record with type, duration, date, and optional notes.
        </p>

        <EditForm Model="newWorkout" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />

            <div class="form-grid">
                <div class="form-group">
                    <label>Exercise Type</label>
                    <InputText class="form-control" @bind-Value="newWorkout.ExerciseType"
                               placeholder="Example: Running, Strength Training" />
                </div>

                <div class="form-group">
                    <label>Duration (min)</label>
                    <InputNumber class="form-control" @bind-Value="newWorkout.DurationMinutes" />
                </div>

                <div class="form-group">
                    <label>Date</label>
                    <InputDate class="form-control" @bind-Value="newWorkout.Date" />
                </div>

                <div class="form-group form-group-full">
                    <label>Notes</label>
                    <InputTextArea class="form-control" @bind-Value="newWorkout.Notes"
                                   placeholder="Optional workout notes" />
                </div>
            </div>

            <div class="button-row">
                <button class="btn btn-primary" type="submit">Add Workout</button>
            </div>
        </EditForm>
    </div>

    <div class="feature-card">
        <div class="feature-icon">🏋️</div>
        <h3>Workout Summary</h3>
        <p>
            Recorded workouts will appear in the table below. Users can edit or delete entries.
        </p>
    </div>
</div>

<div class="feature-card table-card">
    <h3>Workout Records</h3>

    @if (workouts is null)
    {
        <p class="text-muted">Loading workouts...</p>
    }
    else if (!workouts.Any())
    {
        <div class="empty-state">
            <div class="feature-icon">📋</div>
            <h4>No workouts recorded yet</h4>
            <p>Add the first workout using the form above.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Duration</th>
                        <th>Date</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in workouts)
                    {
                        <tr>
                            <td>@w.ExerciseType</td>
                            <td>@w.DurationMinutes min</td>
                            <td>@w.Date.ToString("g")</td>
                            <td>@w.Notes</td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => StartEdit(w.Id)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(w.Id)">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (isEditing && editWorkout is not null)
{
    <div class="feature-card form-card">
        <h3>Edit Workout</h3>
        <p class="form-helper">
            Update the selected workout and save the changes.
        </p>

        <EditForm Model="editWorkout" OnValidSubmit="HandleEditSubmit">
            <DataAnnotationsValidator />

            <div class="form-grid">
                <div class="form-group">
                    <label>Exercise Type</label>
                    <InputText class="form-control" @bind-Value="editWorkout.ExerciseType" />
                </div>

                <div class="form-group">
                    <label>Duration (min)</label>
                    <InputNumber class="form-control" @bind-Value="editWorkout.DurationMinutes" />
                </div>

                <div class="form-group">
                    <label>Date</label>
                    <InputDate class="form-control" @bind-Value="editWorkout.Date" />
                </div>

                <div class="form-group form-group-full">
                    <label>Notes</label>
                    <InputTextArea class="form-control" @bind-Value="editWorkout.Notes" />
                </div>
            </div>

            <div class="button-row">
                <button class="btn btn-primary" type="submit">Save Changes</button>
                <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit">Cancel</button>
            </div>
        </EditForm>
    </div>
}

@code {
    private List<Workout>? workouts;
    private Workout newWorkout = new();
    private bool isEditing = false;
    private Workout? editWorkout;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        workouts = await WorkoutService.GetAllAsync();
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        await WorkoutService.AddAsync(newWorkout);
        newWorkout = new Workout();
        await Load();
    }

    private void StartEdit(Guid id)
    {
        var w = workouts?.FirstOrDefault(x => x.Id == id);
        if (w != null)
        {
            editWorkout = new Workout
            {
                Id = w.Id,
                ExerciseType = w.ExerciseType,
                DurationMinutes = w.DurationMinutes,
                Date = w.Date,
                Notes = w.Notes
            };
            isEditing = true;
        }
    }

    private async Task HandleEditSubmit()
    {
        if (editWorkout is null) return;
        await WorkoutService.UpdateAsync(editWorkout);
        isEditing = false;
        editWorkout = null;
        await Load();
    }

    private void CancelEdit()
    {
        isEditing = false;
        editWorkout = null;
    }

    private async Task Delete(Guid id)
    {
        await WorkoutService.DeleteAsync(id);
        await Load();
    }
}