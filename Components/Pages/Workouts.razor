@page "/workouts"
@rendermode InteractiveServer
@using BlazorApp.Models
@using BlazorApp.Services
@using Microsoft.AspNetCore.Components.Forms
@inject WorkoutService WorkoutService

<PageTitle>Workouts</PageTitle>

<section class="page-header">
    <p class="dashboard-label">Fitness</p>
    <h1>Workout Tracking</h1>
    <p>
        Log workouts, review recorded exercises, edit entries, and remove workouts when needed.
        This page supports the fitness tracking part of the Fitness Nutrition Tracker project.
    </p>
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="app-alert app-alert-success">
        @statusMessage
    </div>
}

<div class="form-layout">
    <div class="feature-card form-card">
        <h3>Log Workout</h3>
        <p class="form-helper">
            Add a workout record with exercise type, duration, date, and optional notes.
        </p>

        <EditForm Model="newWorkout" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <div class="form-grid">
                <div class="form-group">
                    <label>Exercise Type</label>
                    <InputText class="form-control" @bind-Value="newWorkout.ExerciseType"
                               placeholder="Example: Running, Strength Training" />
                </div>

                <div class="form-group">
                    <label>Duration (min)</label>
                    <InputNumber class="form-control" @bind-Value="newWorkout.DurationMinutes" />
                </div>

                <div class="form-group">
                    <label>Date</label>
                    <InputDate class="form-control" @bind-Value="newWorkout.Date" />
                </div>

                <div class="form-group form-group-full">
                    <label>Notes</label>
                    <InputTextArea class="form-control" @bind-Value="newWorkout.Notes"
                                   placeholder="Optional workout notes" />
                </div>
            </div>

            <div class="button-row">
                <button class="btn btn-primary" type="submit">
                    Add Workout
                </button>
            </div>
        </EditForm>
    </div>

    <div class="feature-card">
        <div class="feature-icon">🏋️</div>
        <h3>Workout Summary</h3>
        <p>
            Recorded workouts appear in the table below. Users can edit or delete entries
            to keep their fitness history accurate.
        </p>

        <ul class="clean-list">
            <li><strong>Current records:</strong> @(workouts?.Count ?? 0)</li>
            <li><strong>Status:</strong> Ready for demo</li>
            <li><strong>Feature:</strong> Add, edit, and delete workouts</li>
        </ul>
    </div>
</div>

<div class="feature-card table-card">
    <h3>Workout Records</h3>

    @if (workouts is null)
    {
        <p class="text-muted">Loading workouts...</p>
    }
    else if (!workouts.Any())
    {
        <div class="empty-state">
            <div class="feature-icon">📋</div>
            <h4>No workouts recorded yet</h4>
            <p>Add the first workout using the form above.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Duration</th>
                        <th>Date</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var workout in workouts)
                    {
                        <tr>
                            <td>@workout.ExerciseType</td>
                            <td>@workout.DurationMinutes min</td>
                            <td>@workout.Date.ToString("g")</td>
                            <td>@workout.Notes</td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn btn-sm btn-outline-primary" type="button"
                                            @onclick="() => StartEdit(workout.Id)">
                                        Edit
                                    </button>

                                    <button class="btn btn-sm btn-outline-danger" type="button"
                                            @onclick="() => Delete(workout.Id)">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (isEditing && editWorkout is not null)
{
    <div class="feature-card form-card">
        <h3>Edit Workout</h3>
        <p class="form-helper">
            Update the selected workout and save the changes.
        </p>

        <EditForm Model="editWorkout" OnValidSubmit="HandleEditSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <div class="form-grid">
                <div class="form-group">
                    <label>Exercise Type</label>
                    <InputText class="form-control" @bind-Value="editWorkout.ExerciseType" />
                </div>

                <div class="form-group">
                    <label>Duration (min)</label>
                    <InputNumber class="form-control" @bind-Value="editWorkout.DurationMinutes" />
                </div>

                <div class="form-group">
                    <label>Date</label>
                    <InputDate class="form-control" @bind-Value="editWorkout.Date" />
                </div>

                <div class="form-group form-group-full">
                    <label>Notes</label>
                    <InputTextArea class="form-control" @bind-Value="editWorkout.Notes" />
                </div>
            </div>

            <div class="button-row">
                <button class="btn btn-primary" type="submit">
                    Save Changes
                </button>

                <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit">
                    Cancel
                </button>
            </div>
        </EditForm>
    </div>
}

@code {
    private List<Workout>? workouts;
    private Workout newWorkout = new();
    private bool isEditing;
    private Workout? editWorkout;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        workouts = await WorkoutService.GetAllAsync();
    }

    private async Task HandleValidSubmit()
    {
        await WorkoutService.AddAsync(newWorkout);

        newWorkout = new Workout();
        statusMessage = "Workout added successfully.";

        await Load();
    }

    private void StartEdit(Guid id)
    {
        var selectedWorkout = workouts?.FirstOrDefault(workout => workout.Id == id);

        if (selectedWorkout is null)
        {
            return;
        }

        editWorkout = new Workout
        {
            Id = selectedWorkout.Id,
            ExerciseType = selectedWorkout.ExerciseType,
            DurationMinutes = selectedWorkout.DurationMinutes,
            Date = selectedWorkout.Date,
            Notes = selectedWorkout.Notes
        };

        isEditing = true;
        statusMessage = null;
    }

    private async Task HandleEditSubmit()
    {
        if (editWorkout is null)
        {
            return;
        }

        await WorkoutService.UpdateAsync(editWorkout);

        isEditing = false;
        editWorkout = null;
        statusMessage = "Workout updated successfully.";

        await Load();
    }

    private void CancelEdit()
    {
        isEditing = false;
        editWorkout = null;
        statusMessage = "Workout editing was cancelled.";
    }

    private async Task Delete(Guid id)
    {
        await WorkoutService.DeleteAsync(id);

        statusMessage = "Workout deleted successfully.";

        await Load();
    }
}