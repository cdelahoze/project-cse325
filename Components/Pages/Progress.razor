@page "/progress"

<PageTitle>Progress</PageTitle>

<section class="page-header">
    <p class="dashboard-label">Summary</p>
    <h1>Progress</h1>
    <p>
        This section provides a base dashboard for reviewing nutrition, workouts, goals,
        and overall user progress.
    </p>
</section>

<section class="dashboard-stats">
    <div class="stat-card">
        <span class="stat-number">0</span>
        <span class="stat-label">Meals Logged</span>
    </div>

    <div class="stat-card">
        <span class="stat-number">0</span>
        <span class="stat-label">Workouts Logged</span>
    </div>

    <div class="stat-card">
        <span class="stat-number">0</span>
        <span class="stat-label">Goals Completed</span>
    </div>

    <div class="stat-card">
        <span class="stat-number">0%</span>
        <span class="stat-label">Overall Progress</span>
    </div>
</section>

<div class="feature-card">
    <h3>Future Progress Summary</h3>
    <p>
        This area can later display charts, history, daily summaries, and progress reports
        after the team integrates real user data.
    </p>
</div>