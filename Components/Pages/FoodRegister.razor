@page "/register-food"
@rendermode InteractiveServer
@inject Data.AppDbContext DbContext
@using BlazorApp.Models
@using Microsoft.EntityFrameworkCore

<PageTitle>Register Daily Food</PageTitle>

<section class="page-header">
    <p class="dashboard-label">Nutrition Tracking</p>
    <h1>Register Daily Food</h1>
    <p>
        Search foods from the nutrition database, review their nutrient profile, register portions,
        and view daily nutrition totals by meal type.
    </p>
</section>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="app-alert app-alert-success">
        @successMessage
    </div>
}

<section class="nutrition-layout">
    <div class="feature-card form-card">
        <div class="feature-icon">🔍</div>
        <h3>Search Food</h3>
        <p class="form-helper">
            Type at least two letters to search for a food item.
        </p>

        <input class="form-control mb-3" placeholder="Example: chicken, egg, apple..." value="@searchTerm"
               @oninput="OnSearchChanged" />

        @if (searchResults.Count > 0)
        {
            <div class="food-results-list">
                @foreach (var food in searchResults)
                {
                    <button type="button" class="food-result-item @(selectedFood?.Id == food.Id ? "active" : "")"
                            @onclick="() => SelectFood(food)">
                        @food.Name
                    </button>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <div class="empty-state compact-empty">
                <div class="feature-icon">🔎</div>
                <h4>No results found</h4>
                <p>No food items matched "@searchTerm". Try another search term.</p>
            </div>
        }
        else
        {
            <div class="empty-state compact-empty">
                <div class="feature-icon">🍽️</div>
                <h4>Start searching</h4>
                <p>Search and select a food item to view its nutrition information.</p>
            </div>
        }
    </div>

    <div class="nutrition-detail-area">
        @if (selectedFood is not null)
        {
            <div class="feature-card">
                <div class="food-detail-header">
                    <div>
                        <p class="dashboard-label">Selected Food</p>
                        <h3>@selectedFood.Name</h3>
                        <p class="form-helper">Nutrient values shown per 100 g.</p>
                    </div>

                    <div class="goal-pill">Nutrition profile</div>
                </div>

                <div class="nutrient-grid">
                    @foreach (var nutrient in selectedFood.FoodNutrients.OrderBy(x => x.Nutrient.Name).Take(18))
                    {
                        <div class="nutrient-card">
                            <span>@nutrient.Nutrient.Name</span>
                            <strong>@nutrient.Amount.ToString("0.##") @nutrient.Nutrient.Unit</strong>
                        </div>
                    }
                </div>
            </div>

            <div class="feature-card form-card">
                <h3>Register Portion</h3>
                <p class="form-helper">
                    Add the selected food to your diary by entering grams, meal type, and date.
                </p>

                <div class="form-grid">
                    <div class="form-group">
                        <label>Grams Consumed</label>
                        <input type="number" class="form-control" min="1" @bind="grams" />
                    </div>

                    <div class="form-group">
                        <label>Meal Type</label>
                        <select class="form-control" @bind="mealType">
                            <option value="">-- Select --</option>
                            <option>Breakfast</option>
                            <option>Lunch</option>
                            <option>Dinner</option>
                            <option>Snack</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Date</label>
                        <input type="date" class="form-control" @bind="registerDate" @bind:after="LoadDailyRegisters" />
                    </div>
                </div>

                <div class="button-row">
                    <button class="btn btn-primary" @onclick="RegisterFood"
                            disabled="@(selectedFood is null || string.IsNullOrWhiteSpace(mealType) || grams <= 0)">
                        Add to My Diary
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="feature-card empty-state">
                <div class="feature-icon">📊</div>
                <h3>Nutrition Details</h3>
                <p>
                    Select a food item from the search results to view its nutrient profile
                    and register it in your daily diary.
                </p>
            </div>
        }
    </div>
</section>

<section class="page-header diary-header">
    <p class="dashboard-label">Daily Diary</p>
    <h1>My Diary — @registerDate.ToString("dd/MM/yyyy")</h1>
    <p>
        This section summarizes all foods registered for the selected date.
    </p>
</section>

@if (dailyRegisters.Count == 0)
{
    <div class="feature-card empty-state">
        <div class="feature-icon">📋</div>
        <h3>No food items recorded for this date</h3>
        <p>Search for a food item and add it to your diary to view daily totals.</p>
    </div>
}
else
{
    <section class="dashboard-stats">
        <div class="stat-card">
            <span class="stat-number">@dailyRegisters.Sum(r => GetNutrient(r.Food, "Energy") * r.Grams /
                            100).ToString("0")</span>
                <span class="stat-label">Calories</span>
            </div>

            <div class="stat-card">
                <span class="stat-number">@dailyRegisters.Sum(r => GetNutrient(r.Food, "Protein") * r.Grams /
                                100).ToString("0.#") g</span>
                    <span class="stat-label">Protein</span>
                </div>

                <div class="stat-card">
                    <span class="stat-number">@dailyRegisters.Sum(r => GetNutrient(r.Food, "Carbohydrate, by difference") * r.Grams
                                    / 100).ToString("0.#") g</span>
                        <span class="stat-label">Carbohydrates</span>
                    </div>

                    <div class="stat-card">
                        <span class="stat-number">@dailyRegisters.Sum(r => GetNutrient(r.Food, "Total lipid (fat)") * r.Grams /
                                        100).ToString("0.#") g</span>
                            <span class="stat-label">Fat</span>
                        </div>
                    </section>

                    <div class="feature-card table-card">
                        <h3>Macronutrient Summary</h3>

                        <div class="table-responsive">
                            <table class="app-table">
                                <thead>
                                    <tr>
                                        <th>Meal</th>
                                        <th>Food</th>
                                        <th>Grams</th>
                                        <th>Calories</th>
                                        <th>Protein</th>
                                        <th>Fat</th>
                                        <th>Carbs</th>
                                        <th>Fiber</th>
                                        <th>Cholesterol</th>
                                        <th>Mono Fat</th>
                                        <th>Poly Fat</th>
                                        <th>Saturated Fat</th>
                                        <th>Trans Fat</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var reg in dailyRegisters.OrderBy(r => r.MealType))
                                    {
                                        var factor = reg.Grams / 100.0;
                                        var cal = GetNutrient(reg.Food, "Energy") * factor;
                                        var prot = GetNutrient(reg.Food, "Protein") * factor;
                                        var fat = GetNutrient(reg.Food, "Total lipid (fat)") * factor;
                                        var carbs = GetNutrient(reg.Food, "Carbohydrate, by difference") * factor;
                                        var fiber = GetNutrient(reg.Food, "Fiber, total dietary") * factor;
                                        var cholesterol = GetNutrient(reg.Food, "Cholesterol") * factor;
                                        var monounsaturatedFat = GetNutrient(reg.Food, "Fatty acids, total monounsaturated") * factor;
                                        var polyunsaturatedFat = GetNutrient(reg.Food, "Fatty acids, total polyunsaturated") * factor;
                                        var saturatedFat = GetNutrient(reg.Food, "Fatty acids, total saturated") * factor;
                                        var transFat = GetNutrient(reg.Food, "Fatty acids, total trans") * factor;

                                        <tr>
                                            <td>@reg.MealType</td>
                                            <td>@reg.Food.Name</td>
                                            <td>@reg.Grams g</td>
                                            <td>@cal.ToString("0")</td>
                                            <td>@prot.ToString("0.#") g</td>
                                            <td>@fat.ToString("0.#") g</td>
                                            <td>@carbs.ToString("0.#") g</td>
                                            <td>@fiber.ToString("0.#") g</td>
                                            <td>@cholesterol.ToString("0.#") mg</td>
                                            <td>@monounsaturatedFat.ToString("0.#") g</td>
                                            <td>@polyunsaturatedFat.ToString("0.#") g</td>
                                            <td>@saturatedFat.ToString("0.#") g</td>
                                            <td>@transFat.ToString("0.#") g</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRegister(reg.Id)">
                                                    Delete
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                                <tfoot>
                                    <tr>
                                        <td colspan="3"><strong>Daily Totals</strong></td>
                                        <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Energy") * r.Grams /
                                                                        100).ToString("0")</strong></td>
                                            <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Protein") * r.Grams / 100).ToString("0.#")
                                                g</strong></td>
                                                <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Total lipid (fat)") * r.Grams /
                                                                                100).ToString("0.#") g</strong></td>
                                                    <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Carbohydrate, by difference") * r.Grams /
                                                                                    100).ToString("0.#") g</strong></td>
                                                        <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Fiber, total dietary") * r.Grams /
                                                                                        100).ToString("0.#") g</strong></td>
                                                            <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Cholesterol") * r.Grams /
                                                                                            100).ToString("0.#") mg</strong></td>
                                                                <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Fatty acids, total monounsaturated") *
                                                                                                r.Grams / 100).ToString("0.#") g</strong></td>
                                                                    <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Fatty acids, total polyunsaturated") *
                                                                                                    r.Grams / 100).ToString("0.#") g</strong></td>
                                                                        <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Fatty acids, total saturated") * r.Grams /
                                                                                                        100).ToString("0.#") g</strong></td>
                                                                            <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Fatty acids, total trans") * r.Grams /
                                                                                                            100).ToString("0.#") g</strong></td>
                                                                                <td></td>
                                                                            </tr>
                                                                        </tfoot>
                                                                    </table>
                                                                </div>
                                                            </div>

                                                            <div class="feature-card table-card">
                                                                <h3>Minerals and Vitamins Summary</h3>

                                                                <div class="table-responsive">
                                                                    <table class="app-table">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Meal</th>
                                                                                <th>Food</th>
                                                                                <th>Grams</th>
                                                                                <th>Sodium</th>
                                                                                <th>Potassium</th>
                                                                                <th>Calcium</th>
                                                                                <th>Vitamin A</th>
                                                                                <th>Vitamin B-12</th>
                                                                                <th>Vitamin B-6</th>
                                                                                <th>Vitamin C</th>
                                                                                <th>Vitamin D</th>
                                                                                <th>Vitamin E</th>
                                                                                <th>Vitamin K</th>
                                                                            </tr>
                                                                        </thead>

                                                                        <tbody>
                                                                            @foreach (var reg in dailyRegisters.OrderBy(r => r.MealType))
                                                                            {
                                                                                var factor = reg.Grams / 100.0;
                                                                                var sodium = GetNutrient(reg.Food, "Sodium, Na") * factor;
                                                                                var potassium = GetNutrient(reg.Food, "Potassium, K") * factor;
                                                                                var calcium = GetNutrient(reg.Food, "Calcium, Ca") * factor;
                                                                                var vitaminA = GetNutrient(reg.Food, "Vitamin A") * factor;
                                                                                var vitaminB12 = GetNutrient(reg.Food, "Vitamin B-12") * factor;
                                                                                var vitaminB6 = GetNutrient(reg.Food, "Vitamin B-6") * factor;
                                                                                var vitaminC = GetNutrient(reg.Food, "Vitamin C") * factor;
                                                                                var vitaminD = GetNutrient(reg.Food, "Vitamin D (D2 + D3)") * factor;
                                                                                var vitaminE = GetNutrient(reg.Food, "Vitamin E") * factor;
                                                                                var vitaminK = GetNutrient(reg.Food, "Vitamin K") * factor;

                                                                                <tr>
                                                                                    <td>@reg.MealType</td>
                                                                                    <td>@reg.Food.Name</td>
                                                                                    <td>@reg.Grams g</td>
                                                                                    <td>@sodium.ToString("0.#") mg</td>
                                                                                    <td>@potassium.ToString("0.#") mg</td>
                                                                                    <td>@calcium.ToString("0.#") mg</td>
                                                                                    <td>@vitaminA.ToString("0.#")</td>
                                                                                    <td>@vitaminB12.ToString("0.#")</td>
                                                                                    <td>@vitaminB6.ToString("0.#")</td>
                                                                                    <td>@vitaminC.ToString("0.#")</td>
                                                                                    <td>@vitaminD.ToString("0.#")</td>
                                                                                    <td>@vitaminE.ToString("0.#")</td>
                                                                                    <td>@vitaminK.ToString("0.#")</td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>

                                                                        <tfoot>
                                                                            <tr>
                                                                                <td colspan="3"><strong>Daily Totals</strong></td>
                                                                                <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Sodium, Na") * r.Grams /
                                                                                                                100).ToString("0.#") mg</strong></td>
                                                                                    <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Potassium, K") * r.Grams /
                                                                                                                    100).ToString("0.#") mg</strong></td>
                                                                                        <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Calcium, Ca") * r.Grams /
                                                                                                                        100).ToString("0.#") mg</strong></td>
                                                                                            <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Vitamin A") * r.Grams /
                                                                                                                            100).ToString("0.#")</strong></td>
                                                                                                <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Vitamin B-12") * r.Grams /
                                                                                                                                100).ToString("0.#")</strong></td>
                                                                                                    <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Vitamin B-6") * r.Grams /
                                                                                                                                    100).ToString("0.#")</strong></td>
                                                                                                        <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Vitamin C") * r.Grams /
                                                                                                                                        100).ToString("0.#")</strong></td>
                                                                                                            <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Vitamin D (D2 + D3)") * r.Grams /
                                                                                                                                            100).ToString("0.#")</strong></td>
                                                                                                                <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Vitamin E") * r.Grams /
                                                                                                                                                100).ToString("0.#")</strong></td>
                                                                                                                    <td><strong>@dailyRegisters.Sum(r => GetNutrient(r.Food, "Vitamin K") * r.Grams /
                                                                                                                                                    100).ToString("0.#")</strong></td>
                                                                                                                    </tr>
                                                                                                                </tfoot>
                                                                                                            </table>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                }

@code {
    private string searchTerm = string.Empty;
    private List<Food> searchResults = [];
    private Food? selectedFood;

    private double grams = 100;
    private string mealType = string.Empty;
    private DateTime registerDate = DateTime.Today;
    private string successMessage = string.Empty;

    private List<BlazorApp.Models.FoodRegister> dailyRegisters = [];

    protected override void OnInitialized()
    {
        LoadDailyRegisters();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;

        if (searchTerm.Length < 2)
        {
            searchResults.Clear();
            return;
        }

        var term = searchTerm.ToLower();

        searchResults = DbContext.Foods
            .Where(food => food.Name.ToLower().Contains(term))
            .OrderBy(food => food.Name)
            .Take(30)
            .ToList();
    }

    private void SelectFood(Food food)
    {
        selectedFood = DbContext.Foods
            .Include(f => f.FoodNutrients)
            .ThenInclude(fn => fn.Nutrient)
            .FirstOrDefault(f => f.Id == food.Id);

        successMessage = string.Empty;
    }

    private void RegisterFood()
    {
        if (selectedFood is null || string.IsNullOrWhiteSpace(mealType) || grams <= 0)
        {
            return;
        }

        var register = new BlazorApp.Models.FoodRegister
        {
            FoodId = selectedFood.Id,
            Date = registerDate,
            Grams = grams,
            MealType = mealType
        };

        DbContext.FoodRegisters.Add(register);
        DbContext.SaveChanges();

        successMessage = $"{selectedFood.Name} ({grams}g) was added to {mealType}.";
        LoadDailyRegisters();
    }

    private void DeleteRegister(int id)
    {
        var register = DbContext.FoodRegisters.Find(id);

        if (register is not null)
        {
            DbContext.FoodRegisters.Remove(register);
            DbContext.SaveChanges();
            successMessage = "Food record deleted successfully.";
            LoadDailyRegisters();
        }
    }

    private void LoadDailyRegisters()
    {
        dailyRegisters = DbContext.FoodRegisters
            .Where(register => register.Date.Date == registerDate.Date)
            .Include(register => register.Food)
            .ThenInclude(food => food.FoodNutrients)
            .ThenInclude(foodNutrient => foodNutrient.Nutrient)
            .OrderBy(register => register.MealType)
            .ToList();
    }

    private double GetNutrient(Food food, string nutrientName)
    {
        return food.FoodNutrients
            .FirstOrDefault(foodNutrient =>
                foodNutrient.Nutrient.Name.Equals(nutrientName, StringComparison.OrdinalIgnoreCase))
            ?.Amount ?? 0;
    }
}