@using BlazorApp.Models
@using BlazorApp.Services
@inject ProfileService ProfileService

<h3>Perfil de usuario</h3>

<EditForm Model="profileModel" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Nombre</label>
        <InputText @bind-Value="profileModel.Name" />
    </div>
    <div>
        <label>Peso inicial (kg)</label>
        <InputNumber @bind-Value="profileModel.InitialWeightKg" />
    </div>
    <div>
        <label>Altura (cm)</label>
        <InputNumber @bind-Value="profileModel.HeightCm" />
    </div>
    <div>
        <label>Edad</label>
        <InputNumber @bind-Value="profileModel.Age" />
    </div>

    <button type="submit">Guardar</button>
    <button type="button" @onclick="Delete">Eliminar</button>
</EditForm>

@code {
    private Profile profileModel = new();

    protected override async Task OnInitializedAsync()
    {
        var existing = await ProfileService.GetAsync();
        if (existing is not null) profileModel = existing;
    }

    private async Task Save()
    {
        await ProfileService.SaveAsync(profileModel);
    }

    private async Task Delete()
    {
        await ProfileService.DeleteAsync();
        profileModel = new Profile();
    }
}
