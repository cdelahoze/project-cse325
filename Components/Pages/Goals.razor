@page "/goals"

<PageTitle>Goals</PageTitle>

<section class="page-header">
    <p class="dashboard-label">Planning</p>
    <h1>Goals</h1>
    <p>
        This section provides a base structure for personal fitness and nutrition goals.
        It can later be connected to goal management features.
    </p>
</section>

<div class="feature-grid">
    <div class="feature-card">
        <div class="feature-icon">⚖️</div>
        <h3>Weight Goal</h3>
        <p>
            Track target weight, starting weight, and future weight progress.
        </p>
    </div>

    <div class="feature-card">
        <div class="feature-icon">🥗</div>
        <h3>Nutrition Goal</h3>
        <p>
            Plan nutrition goals related to calories, protein, carbohydrates, and fat intake.
        </p>
    </div>

    <div class="feature-card">
        <div class="feature-icon">🏃</div>
        <h3>Workout Goal</h3>
        <p>
            Set weekly workout goals and monitor exercise consistency.
        </p>
    </div>
</div>